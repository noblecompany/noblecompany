# ============================================================
# Vercel 프로젝트 환경변수 목록 — 값은 Vercel 대시보드에 직접 입력한다.
# 이 파일에는 절대 실제 값을 쓰지 않는다 (공개 저장소).
# ============================================================

# --- Supabase (프로젝트 Settings → API 에서 확인) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # service_role 키 — 서버 전용, 노출 금지

# --- HIWORKS SMTP (F6 접수 알림) ---
SMTP_HOST=smtps.hiworks.com
SMTP_PORT=465
SMTP_USER=                          # 인증 실계정 (예: noreply@e-noble.kr 또는 noble@)
SMTP_PASS=                          # 계정 비밀번호
MAIL_FROM=noble@e-noble.kr          # 표시 발신 주소 — 별칭 발신 불가 시 SMTP_USER 로
MAIL_TO=noble@e-noble.kr            # 알림 수신처 (팀 공용함)

# --- 봇 방지 (F8) — 미설정 시 검증 생략(개발용). 오픈 전 필수 설정 ---
TURNSTILE_SECRET_KEY=

# --- Vercel Cron 보호 (§3.2 ping) ---
CRON_SECRET=
